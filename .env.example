# ─────────────────────────────────────────────────────────────
#  Ardoise — variables d'environnement
#  Copiez ce fichier en .env.local puis remplissez les valeurs.
#  Test → live : il suffit de remplacer les clés Stripe (sk_test → sk_live).
# ─────────────────────────────────────────────────────────────

# URL publique de l'app (en local : http://localhost:3300 ; sur Vercel : https://xxx.vercel.app)
APP_URL=http://localhost:3300

# Auth.js — générez un secret :  npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET=

# Neon Postgres — « Connection string » du projet (pooled), région Europe.
# Laisser VIDE en local pour utiliser la base embarquée PGlite (.data/), sans compte.
DATABASE_URL=

# Stripe — mode TEST (Dashboard Stripe → Développeurs → Clés API, « mode test » activé)
STRIPE_SECRET_KEY=sk_test_...
# Secret du webhook (whsec_...) :
#  - en local : affiché par `stripe listen --forward-to localhost:3300/api/stripe/webhook`
#  - en ligne : Stripe → Développeurs → Webhooks → endpoint <APP_URL>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Optionnel — utiliser des Prix Stripe existants au lieu des prix créés à la volée
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_YEARLY=price_...

# Optionnel — masquer le bandeau « démo / carte test » (il disparaît de toute façon avec une clé sk_live_)
# SHOW_DEMO_BANNER=false
