{
  "name": "ardoise",
  "version": "1.0.0",
  "private": true,
  "description": "Ardoise — factures et devis pour freelances (micro-SaaS de démonstration)",
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "tsx scripts/migrate.mts && next build",
    "start": "next start -p 3300",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.mts",
    "test:e2e": "esbuild scripts/e2e.mts --bundle --platform=node --format=esm --packages=external --jsx=automatic --alias:@=./src --alias:server-only=./scripts/empty.mjs --log-level=warning --outfile=.next/e2e.mjs && node .next/e2e.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@neondatabase/serverless": "^1.2.1",
    "@react-pdf/renderer": "^4.9.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.76.0",
    "next": "^16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "stripe": "^23.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}
